<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>NovaProtect.UpdateSmoke</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- ProtectionOptions.cs now references these two, so the smoke harness has to
         compile them alongside it or the linked file will not resolve. -->
    <Compile Include="..\..\ui\Models\EvasionOptions.cs" Link="Models\EvasionOptions.cs" />
    <Compile Include="..\..\ui\Models\ProtectionOptions.cs" Link="Models\ProtectionOptions.cs" />
    <Compile Include="..\..\ui\Services\UpdateClient.cs" Link="Services\UpdateClient.cs" />
    <!-- The option models render their labels through Localizer; compile the real
         translation core so the harness links against the shipped strings.
         Localizer.VisualTree.cs is WinUI-only and stays out. -->
    <Compile Include="..\..\ui\Services\Localizer.cs" Link="Services\Localizer.cs" />
    <Compile Include="..\..\ui\Services\LocalizerStrings.cs" Link="Services\LocalizerStrings.cs" />
    <Compile Include="..\..\ui\Services\ClientDiagnosticLog.cs" Link="Services\ClientDiagnosticLog.cs" />
  </ItemGroup>
</Project>
