# ---- build outputs ---------------------------------------------------------
bin/
obj/
artifacts/
output/
_wtest/
_icontest/
evidence/
tests/_reg/
docs/archive/

# Scratch copies of superseded sources: a stale main.cpp / prot64.c next to the
# real ones is worse than no copy at all.
.work-backup-*/

# ---- generated artefacts (build.ps1 regenerates them) ----------------------
# The marker/label values are rebuilt from source; committing them would let a
# stale blob silently override a fresh build.
*.novaprotect-build.json
*.novaprotect-prebuild.json
runtime/*.o
runtime/*.bin
runtime/*.res
runtime/*.ldimg
tools/*.exe
*.pdb
*.map

# ---- tools, caches, IDE ----------------------------------------------------
__pycache__/
*.py[cod]
.playwright-cli/
.vs/
.idea/
*.user
*.suo

# ---- logs and scratch ------------------------------------------------------
*.log
*.vmprotect.log
_regress_out.txt
_regress_icon.txt
_writetest.txt
*.tmp
*.dbg_bak
*.check
*.real
Thumbs.db
desktop.ini
.DS_Store

# ---- secrets and commercial binaries (never commit) ------------------------
# The engine builds without the commercial VMProtect SDK by defining
# NOVAPROTECT_VMP_STUB; build.ps1 selects that automatically when the SDK is
# absent. Neither the import libraries nor the runtime DLL may be redistributed.
third_party/vmprotect/
artifacts/private-signing/
client-integrity.key.xml
VMProtectSDK64.dll
VMProtectSDK64.a
VMProtectSDK64.lib
VMProtectSDK.h
VMProtectSDK32.h
*.vmp
*.pfx
*.snk
*.p12
*.private.pem
id_rsa*
id_ed25519*
.env

# ---- analysis artefacts ----------------------------------------------------
# Sandbox reports and packet captures describe what this product does; they are
# not source and they name the environments they were collected in.
*.pcap
*.pcapng
