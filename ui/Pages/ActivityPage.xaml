<Page
    x:Class="NovaProtect.UI.Pages.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaProtect.UI.Controls">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <Border Style="{StaticResource PillSoftStyle}" HorizontalAlignment="Left">
                    <TextBlock Text="HISTORY" Style="{StaticResource CardEyebrowStyle}" />
                </Border>
                <TextBlock Text="运行记录" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="记录保存在本机，直到你手动删除。"
                           Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>
            <Button x:Name="ClearButton" Grid.Column="1" Click="ClearButton_Click"
                    Style="{StaticResource RoundedButtonStyle}" VerticalAlignment="Center"
                    AutomationProperties.Name="清空运行记录"
                    ToolTipService.ToolTip="清空运行记录">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock Text="清空记录" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <ListView x:Name="ActivityList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <controls:GlassCardHoverHost CornerRadius="16"
                                                     CardPadding="16,12" Margin="0,0,0,10">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="11"
                                        Background="{StaticResource NovaAccentGradientBrush}">
                                    <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource NovaOnAccentFgBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleTextStyle}"
                                               MaxLines="2" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Time}" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12" />
                                <Button Grid.Column="3" Tag="{Binding}" Click="DeleteItem_Click"
                                        Width="34" Height="34" Padding="0"
                                        Style="{StaticResource RoundedButtonStyle}"
                                        AutomationProperties.Name="删除该条记录"
                                        ToolTipService.ToolTip="删除该条记录">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </Grid>
                        </controls:GlassCardHoverHost>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="10" Opacity="0.9">
                <Border Width="72" Height="72" CornerRadius="24"
                        Background="{ThemeResource NovaBadgeBrush}"
                        BorderBrush="{ThemeResource NovaBadgeBorderBrush}" BorderThickness="1"
                        HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="28"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="暂无保护记录" Style="{StaticResource EmptyStateTitleStyle}" />
                <TextBlock Text="完成一次保护后，结果会出现在这里。"
                           Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
