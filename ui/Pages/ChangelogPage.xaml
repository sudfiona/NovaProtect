<Page
    x:Class="NovaProtect.UI.Pages.ChangelogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaProtect.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <Border Style="{StaticResource PillSoftStyle}" HorizontalAlignment="Left">
                    <TextBlock Text="RELEASES" Style="{StaticResource CardEyebrowStyle}" />
                </Border>
                <TextBlock Text="更新日志" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="与 GitHub Releases 同步；离线时显示随程序打包的版本记录。"
                           Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>
            <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource RoundedButtonStyle}"
                    VerticalAlignment="Center" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="刷新" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar x:Name="StatusBar" Grid.Row="1" Margin="0,0,0,12" IsOpen="False" IsClosable="False" />

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <ItemsControl x:Name="ReleaseList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:GlassCardHoverHost CornerRadius="20"
                                                             Margin="0,0,0,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource PillSoftStyle}"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding VersionLabel}"
                                                           Style="{StaticResource PillTextStyle}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="15"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        Spacing="8" VerticalAlignment="Center">
                                                <Border x:Name="CurrentBadge"
                                                        Visibility="{Binding CurrentBadgeVisibility}"
                                                        Style="{StaticResource PillSuccessStyle}">
                                                    <TextBlock Text="当前版本" Style="{StaticResource PillTextStyle}" />
                                                </Border>
                                                <TextBlock Text="{Binding PublishedLabel}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{ThemeResource NovaTitleDividerBrush}" />
                                        <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" FontSize="13"
                                                   LineHeight="22"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   IsTextSelectionEnabled="True" />
                                        <HyperlinkButton Content="在 GitHub 查看完整说明"
                                                         NavigateUri="{Binding PageUrl}"
                                                         Visibility="{Binding LinkVisibility}"
                                                         Padding="0" FontSize="12" />
                                    </StackPanel>
                                </controls:GlassCardHoverHost>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="EmptyCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10" HorizontalAlignment="Center" Padding="0,28">
                            <Border Width="64" Height="64" CornerRadius="20"
                                    Background="{ThemeResource NovaBadgeBrush}"
                                    BorderBrush="{ThemeResource NovaBadgeBorderBrush}" BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE7C3;" FontSize="24"
                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="暂无更新记录" Style="{StaticResource EmptyStateTitleStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ProgressRing x:Name="BusyRing" IsActive="False" Width="36" Height="36"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
