<Page
    x:Class="NovaProtect.UI.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaProtect.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="14">

            <StackPanel Spacing="6" Margin="0,4,0,0">
                <Border Style="{StaticResource PillSoftStyle}" HorizontalAlignment="Left">
                    <TextBlock Text="PREFERENCES" Style="{StaticResource CardEyebrowStyle}" />
                </Border>
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观设置立即生效；在线更新从官网读取已发布的客户端版本。"
                           Style="{StaticResource SubtleTextStyle}" MaxWidth="520" />
            </StackPanel>

            <controls:GlassCardHoverHost CornerRadius="20">
                <StackPanel Spacing="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTileStyle}" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE706;" FontSize="17" Foreground="{ThemeResource NovaOnAccentFgBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="HyperOS 柔光玻璃 · 极光背景 · 品牌渐变强调色"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="视觉主题" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="与官网一致：玻璃 / 波普 / 实验室。立即生效并记住选择。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Right"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectionChanged="ThemeBox_SelectionChanged">
                            <ComboBoxItem Content="液态玻璃（默认）" Tag="glass" />
                            <ComboBoxItem Content="新波普" Tag="pop" />
                            <ComboBoxItem Content="暗色实验室" Tag="lab" />
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="界面语言" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="只影响客户端界面文字，不改变构建行为。默认跟随已保存的设置。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Right"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectionChanged="LanguageBox_SelectionChanged">
                            <ComboBoxItem Content="简体中文" Tag="zh" />
                            <ComboBoxItem Content="英语" Tag="en" />
                        </ComboBox>
                    </Grid>

                    <Grid ColumnSpacing="10" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Height="44" CornerRadius="12" Background="#2E7CF6">
                            <TextBlock Text="Accent" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="1" Height="44" CornerRadius="12" Background="#7B61FF">
                            <TextBlock Text="Violet" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="2" Height="44" CornerRadius="12"
                                Background="{ThemeResource NovaGlassCardBrush}"
                                BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="Glass" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Column="3" Height="44" CornerRadius="12"
                                Background="{StaticResource NovaAccentGradientBrush}">
                            <TextBlock Text="Grad" FontSize="11" FontWeight="SemiBold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </StackPanel>
            </controls:GlassCardHoverHost>

            <controls:GlassCardHoverHost CornerRadius="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTileStyle}" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{ThemeResource NovaOnAccentFgBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="关于 NovaProtect" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="WinUI 3 · HyperOS 柔光玻璃客户端"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{StaticResource NovaAccentGradientBrush}"
                                Padding="8">
                            <Image Source="../Assets/NovaProtect.png" Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="ProductVersionText" FontWeight="SemiBold" FontSize="15" />
                            <TextBlock Text="与官网 nova.fbi.plus 同一设计语言"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="用于保护您拥有合法授权的软件。请在发布前对目标程序执行完整兼容性和安全性测试。"
                               Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource PillMutedStyle}" HorizontalAlignment="Left">
                        <TextBlock Text="C/C++ · C#/VB .NET · Rust · Golang EXE    ·    C++17 / Windows PE"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock Text="客户端不需要账户登录；官网仅提供安装包下载与版本发布。"
                               Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </controls:GlassCardHoverHost>

            <controls:GlassCardHoverHost CornerRadius="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTileStyle}" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE74C;" FontSize="17" Foreground="{ThemeResource NovaOnAccentFgBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="数据与诊断" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="全部保存在本机，不上传任何服务器。"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource RoundedButtonStyle}" Click="OpenLogFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                <TextBlock Text="打开日志目录" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RoundedButtonStyle}" Click="OpenDataFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                <TextBlock Text="打开配置目录" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DataPathText" Style="{StaticResource SubtleTextStyle}" FontSize="12"
                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Grid ColumnSpacing="8" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource RoundedButtonStyle}" Click="ResetEvasion_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="恢复默认规避设置" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="1" Text="只重置对抗与规避设置，不影响项目文件和历史记录。"
                                   Style="{StaticResource SubtleTextStyle}" FontSize="12"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </controls:GlassCardHoverHost>

            <controls:GlassCardHoverHost CornerRadius="20" Margin="0,0,0,16">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTileStyle}" Margin="0,0,12,0">
                            <FontIcon Glyph="&#xE777;" FontSize="17" Foreground="{ThemeResource NovaOnAccentFgBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="在线更新" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="从官网 client-updates 清单读取已发布版本"
                                       Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="UpdateStatusBar" Title="更新状态" Message="尚未检查更新。"
                             IsOpen="True" IsClosable="False" Severity="Informational" />
                    <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource NovaProgressBarStyle}"
                                 Minimum="0" Maximum="1" Value="0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Accessibility name comes from the localized Content, so
                             these three no longer carry a hardcoded Chinese one. -->
                        <Button x:Name="CheckUpdateButton" Click="CheckUpdate_Click"
                                Style="{StaticResource AccentActionButtonStyle}"
                                Content="检查更新" />
                        <Button x:Name="DownloadUpdateButton" Click="DownloadUpdate_Click"
                                Visibility="Collapsed" Style="{StaticResource RoundedButtonStyle}"
                                Content="下载更新" />
                        <Button x:Name="OpenUpdateButton" Click="OpenUpdate_Click"
                                Visibility="Collapsed" Style="{StaticResource RoundedButtonStyle}"
                                Content="运行安装包" />
                    </StackPanel>
                </StackPanel>
            </controls:GlassCardHoverHost>
        </StackPanel>
    </ScrollViewer>
</Page>
