<Page
    x:Class="NovaProtect.UI.Pages.EvasionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="1080" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="对抗与规避" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="控制静态特征清洗、反分析探测与内核驱动探针。这些设置对保护项目页的每次运行生效。"
                               Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
                <Border Grid.Column="1" Padding="10,5" CornerRadius="8"
                        Background="{ThemeResource AccentFillColorSecondaryBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="ProfileBadge" Text="均衡" FontSize="12" />
                </Border>
            </Grid>

            <InfoBar x:Name="EvasionWarnBar" IsOpen="False" IsClosable="False" Severity="Warning" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="规避档位" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="ProfileDescription" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>

                    <RadioButtons x:Name="ProfilePicker" MaxColumns="4" SelectionChanged="ProfilePicker_SelectionChanged">
                        <RadioButton Content="关闭" Tag="0" />
                        <RadioButton Content="均衡" Tag="1" />
                        <RadioButton Content="激进" Tag="2" />
                        <RadioButton Content="偏执" Tag="3" />
                    </RadioButtons>

                    <Expander Header="档位展开明细" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <!-- Four profiles side by side. A single-column view was
                                 unreadable: at 均衡 twelve of sixteen rows read "是",
                                 so the table looked like the same value repeated and
                                 hid the fact that 激进 and 偏执 differ in seven
                                 numeric fields. The active column is marked in the
                                 header instead of tinted rows, which avoids a
                                 converter and stays legible in high contrast. -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="项目" Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="HeadOff" Grid.Column="1" Text="关闭"
                                           Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="HeadBalanced" Grid.Column="2" Text="均衡"
                                           Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="HeadAggressive" Grid.Column="3" Text="激进"
                                           Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="HeadParanoid" Grid.Column="4" Text="偏执"
                                           Style="{StaticResource SubtleTextStyle}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                            <ListView x:Name="ProfileDetailList" SelectionMode="None" MaxHeight="360">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource SubtleTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding Off}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Balanced}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="3" Text="{Binding Aggressive}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="4" Text="{Binding Paranoid}" FontSize="12" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="构建签名种子" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="种子决定标签、nonce、节区后缀、填充与探测顺序。留空则每次构建从系统熵取新值，两次构建不会共享字节特征；填入固定值可复现同一构建。"
                                   Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" FontSize="12" />
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SeedBox" PlaceholderText="留空 = 随机；或填 1-16 位十六进制" Style="{StaticResource RoundedTextBoxStyle}" />
                        <Button Grid.Column="1" Style="{StaticResource RoundedButtonStyle}" Click="RandomSeed_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="生成" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="CopySeedButton" Style="{StaticResource RoundedButtonStyle}" Click="CopySeed_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="复制" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ToggleSwitch x:Name="ReseedSwitch" Header="每次构建重新随机"
                                  OnContent="已开启：忽略种子，重新取熵" OffContent="已关闭：按种子复现"
                                  Toggled="ReseedSwitch_Toggled" />
                    <TextBlock x:Name="SeedStatusText" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="动态对抗" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="运行期探测强度。级别越高越容易识别分析环境，也越容易在真实用户机器上误触发。"
                                   Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="垃圾指令密度" />
                            <TextBlock x:Name="JunkValue" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="JunkSlider" Minimum="0" Maximum="8" StepFrequency="1" Value="2"
                                ValueChanged="JunkSlider_ValueChanged" />
                        <TextBlock Text="每个注入点插入的垃圾指令块数量。0 表示不插入。" Style="{StaticResource SubtleTextStyle}" FontSize="12" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <TextBlock Text="反沙箱级别" />
                            <ComboBox x:Name="AntiSandboxBox" HorizontalAlignment="Stretch" SelectedIndex="2" SelectionChanged="AntiSandboxBox_SelectionChanged">
                                <ComboBoxItem Content="关闭" Tag="0" />
                                <ComboBoxItem Content="基础" Tag="1" />
                                <ComboBoxItem Content="增强" Tag="2" />
                                <ComboBoxItem Content="严格" Tag="3" />
                            </ComboBox>
                            <TextBlock Text="驱动加权沙箱评分。需配合沙箱阈值使用。" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="内存流式解密" />
                            <ComboBox x:Name="MemStreamBox" HorizontalAlignment="Stretch" SelectedIndex="2" SelectionChanged="MemStreamBox_SelectionChanged">
                                <ComboBoxItem Content="驻留（不解密流）" Tag="0" />
                                <ComboBoxItem Content="1 轮" Tag="1" />
                                <ComboBoxItem Content="2 轮" Tag="2" />
                                <ComboBoxItem Content="3 轮" Tag="3" />
                            </ComboBox>
                            <TextBlock Text="加密区按需解密的密钥流轮数。轮数越多，内存快照越难直接还原。" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="引爆延迟" />
                            <TextBlock x:Name="DelayValue" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="DelaySlider" Minimum="0" Maximum="15000" StepFrequency="250" Value="2500"
                                ValueChanged="DelaySlider_ValueChanged" />
                        <TextBlock Text="执行前等待时长。分析沙箱通常只观察很短时间，真实用户几乎感觉不到。0 表示不等待。"
                                   Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch x:Name="UnhookSwitch" Header="API 反挂钩"
                                  OnContent="已开启：还原磁盘 ntdll 文本并扫描 IAT 重定向"
                                  OffContent="已关闭：保留系统当前挂钩状态"
                                  Toggled="UnhookSwitch_Toggled" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="3">
                        <TextBlock Text="内核与 hypervisor" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="驱动级探针与 hypervisor 存在性判定。两者都不信任对方自报的标志位，改用可测量的行为差异。"
                                   Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock Text="驱动探针层级" />
                            <TextBlock x:Name="KernelValue" HorizontalAlignment="Right"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Slider x:Name="KernelSlider" Minimum="0" Maximum="3" StepFrequency="1" Value="2"
                                ValueChanged="KernelSlider_ValueChanged" />
                        <TextBlock x:Name="KernelDescription" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch x:Name="HvExitCostSwitch" Header="CPUID 退出代价探测"
                                  OnContent="已开启：用 16 次串行 CPUID 的耗时差判定 hypervisor"
                                  OffContent="已关闭：只信 CPUID 厂商叶子"
                                  Toggled="HvExitCostSwitch_Toggled" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Style="{StaticResource RoundedButtonStyle}" Click="RunHvAudit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                                <TextBlock Text="审计本机 hypervisor" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RoundedButtonStyle}" Click="RunKernelAudit_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE7F8;" FontSize="14" />
                                <TextBlock Text="审计本机内核工件" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="审计只读取本机状态并打印结论，不改动任何文件，也不需要管理员权限。"
                               Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock Text="环境闸门" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="判定是否在沙箱或无头环境中运行。分数达到阈值即拒绝执行。阈值越低越严格，也越容易误杀低配真机。"
                                   Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                            <Grid>
                                <TextBlock Text="沙箱分数阈值" />
                                <TextBlock x:Name="SandboxThresholdValue" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="SandboxThresholdSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="40"
                                    ValueChanged="SandboxThresholdSlider_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <Grid>
                                <TextBlock Text="无头环境分数阈值" />
                                <TextBlock x:Name="EnvThresholdValue" HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="EnvThresholdSlider" Minimum="0" Maximum="100" StepFrequency="1" Value="7"
                                    ValueChanged="EnvThresholdSlider_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="硬件下限（0 = 不检查）" FontWeight="SemiBold" Margin="0,4,0,0" />

                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="逻辑处理器数" FontSize="12" />
                            <NumberBox x:Name="MinCpuBox" Minimum="0" Maximum="256" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinCpuBox_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="物理内存 (MB)" FontSize="12" />
                            <NumberBox x:Name="MinRamBox" Minimum="0" Maximum="1048576" SmallChange="256" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinRamBox_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="系统运行时长 (ms)" FontSize="12" />
                            <NumberBox x:Name="MinUptimeBox" Minimum="0" Maximum="4294967295" SmallChange="1000" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinUptimeBox_ValueChanged" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="4">
                            <TextBlock Text="屏幕宽度" FontSize="12" />
                            <NumberBox x:Name="MinScreenWBox" Minimum="0" Maximum="32767" SmallChange="80" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinScreenWBox_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                            <TextBlock Text="屏幕高度" FontSize="12" />
                            <NumberBox x:Name="MinScreenHBox" Minimum="0" Maximum="32767" SmallChange="60" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinScreenHBox_ValueChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                            <TextBlock Text="显示器数量" FontSize="12" />
                            <NumberBox x:Name="MinMonitorBox" Minimum="0" Maximum="64" SpinButtonPlacementMode="Compact"
                                       ValueChanged="MinMonitorBox_ValueChanged" />
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="GateSummaryText" Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="环境闸门只在保护项目页开启“沙箱防护”或“环境检查”时生效；否则这些阈值会被记录但不参与判定。"
                               Style="{StaticResource SubtleTextStyle}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="审计输出" Style="{StaticResource SectionTitleStyle}" />
                    <TextBox x:Name="AuditBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                             MinHeight="180" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Style="{StaticResource RoundedTextBoxStyle}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentActionButtonStyle}" Click="Save_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontSize="14" />
                        <TextBlock Text="保存设置" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource RoundedButtonStyle}" Click="Reset_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE777;" FontSize="14" />
                        <TextBlock Text="恢复默认" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
