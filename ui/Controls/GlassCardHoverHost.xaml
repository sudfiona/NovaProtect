<UserControl
    x:Class="NovaProtect.UI.Controls.GlassCardHoverHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Website card / glass:
          background: rgba(255,255,255,0.62)
          border: 1px solid rgba(255,255,255,0.85) + gradient light edge
          shadow: ThemeShadow (WinUI-safe elevation)
          hover: translateY(-4px)
    -->
    <Border x:Name="BorderHost"
            Background="{ThemeResource NovaGlassCardBrush}"
            BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
            BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <CompositeTransform />
        </Border.RenderTransform>
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <ContentPresenter />
    </Border>
</UserControl>
