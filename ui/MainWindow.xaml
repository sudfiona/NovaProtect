<Window
    x:Class="NovaProtect.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaProtect.UI.Controls"
    Title="NovaProtect">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- Aurora backdrop -->
        <Grid x:Name="AuroraLayer" IsHitTestVisible="False">
            <Border Background="{ThemeResource NovaVeilBrush}" />
            <Border Background="{StaticResource NovaPageBackdropBrush}" />

            <Ellipse x:Name="GlowBlue" Width="640" Height="640"
                     Margin="-230,-250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Opacity="0.6">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowBlueCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowBlueEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowCyan" Width="560" Height="560"
                     Margin="0,-260,-200,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Opacity="0.5">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowCyanCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowCyanEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowViolet" Width="700" Height="700"
                     Margin="0,0,-200,-260" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Opacity="0.6">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowVioletCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowVioletEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowRose" Width="520" Height="520"
                     Margin="-240,0,0,-220" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Opacity="0.4">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowRoseCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowRoseEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource IconTileStyle}" Width="30" Height="30"
                        Margin="16,0,0,0" VerticalAlignment="Center">
                    <Image Width="22" Height="22" Source="Assets/NovaProtect.png"
                           Stretch="Uniform" Margin="3" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="NovaProtect" FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillSoftStyle}">
                        <TextBlock x:Name="VersionText" Style="{StaticResource PillTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <Grid x:Name="AppTitleBar" Grid.Column="2" Background="Transparent" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
                    <controls:ThemeSwitchBar />
                    <ToggleButton x:Name="PauseThemeMotion" Click="OnThemeMotionClick" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE769;" FontSize="12" />
                    </ToggleButton>
                </StackPanel>

                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                           Fill="{ThemeResource NovaTitleDividerBrush}" />
            </Grid>

            <Grid x:Name="WorkspaceGrid" Grid.Row="1" Padding="12,0,12,12">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="TopDockRow" Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="BottomDockRow" Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftRailColumn" Width="0" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightRailColumn" Width="0" />
              </Grid.ColumnDefinitions>

            <Grid x:Name="StatusStrip" Grid.Row="1" Grid.Column="1" MinHeight="42" Padding="12,5" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <controls:BlackHoleScene x:Name="Singularity" Width="232" Height="116"
                                             Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                    <controls:ThemeAmbientScene x:Name="ThemeOrnament" Width="126" Height="42"
                                               Visibility="Collapsed" AutomationProperties.AccessibilityView="Raw" />
                </Grid>
                <StackPanel x:Name="StatusText" Spacing="3" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="保护项目"
                               FontFamily="{ThemeResource NovaDisplayFontFamily}"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PageHintText"
                               Text="选择目标、调整策略、构建受保护版本"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource PillSoftStyle}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusChip" Text="就绪"
                               Style="{StaticResource PillTextStyle}" />
                </Border>
            </Grid>

                <Border x:Name="NavigationCard" Grid.Row="1" Grid.RowSpan="2"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Background="{ThemeResource NovaGlassCardBrush}"
                        BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
                        BorderThickness="{ThemeResource NovaCardBorderThickness}">
                    <StackPanel>
                        <TextBlock x:Name="WorkspaceLabel" Text="工作台" FontSize="11" FontWeight="Bold"
                                   Margin="10,2,10,10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Grid x:Name="NavigationItems">
                            <RadioButton x:Name="NavProtect" GroupName="NovaNav" Tag="&#xE72E;"
                                         IsChecked="True" Content="保护项目"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavEvasion" GroupName="NovaNav" Tag="&#xE9D9;"
                                         Content="对抗与规避"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavInspect" GroupName="NovaNav" Tag="&#xE721;"
                                         Content="检查工具"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavActivity" GroupName="NovaNav" Tag="&#xE81C;"
                                         Content="运行记录"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavChangelog" GroupName="NovaNav" Tag="&#xE7C3;"
                                         Content="更新日志"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavSettingsBtn" GroupName="NovaNav" Tag="&#xE713;"
                                         Content="设置"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ContentCard" Grid.Row="2" Grid.Column="1"
                        CornerRadius="{ThemeResource CardCornerRadius}"
                        Background="{ThemeResource NovaGlassCardBrush}"
                        BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
                        BorderThickness="{ThemeResource NovaCardBorderThickness}">
                    <Frame x:Name="PageHost" RenderTransformOrigin="0.5,0.5" />
                </Border>
            </Grid>
        </Grid>

    </Grid>
</Window>
