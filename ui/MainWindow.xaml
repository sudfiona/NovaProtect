<Window
    x:Class="NovaProtect.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NovaProtect.UI.Controls"
    Title="NovaProtect">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Storyboard x:Key="AuroraPulse">
                <DoubleAnimation Storyboard.TargetName="GlowBlue" Storyboard.TargetProperty="Opacity"
                                 From="0.55" To="0.88" Duration="0:0:9" AutoReverse="True"
                                 RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="GlowCyan" Storyboard.TargetProperty="Opacity"
                                 From="0.45" To="0.78" Duration="0:0:11" AutoReverse="True"
                                 RepeatBehavior="Forever" />
                <DoubleAnimation Storyboard.TargetName="GlowViolet" Storyboard.TargetProperty="Opacity"
                                 From="0.55" To="0.92" Duration="0:0:13" AutoReverse="True"
                                 RepeatBehavior="Forever" BeginTime="0:0:1.5" />
                <DoubleAnimation Storyboard.TargetName="GlowRose" Storyboard.TargetProperty="Opacity"
                                 From="0.35" To="0.65" Duration="0:0:10" AutoReverse="True"
                                 RepeatBehavior="Forever" BeginTime="0:0:0.8" />
            </Storyboard>
        </Grid.Resources>

        <!-- Aurora backdrop -->
        <Grid x:Name="AuroraLayer" IsHitTestVisible="False">
            <Border Background="{ThemeResource NovaVeilBrush}" />
            <Border Background="{StaticResource NovaPageBackdropBrush}" />

            <Ellipse x:Name="GlowBlue" Width="640" Height="640"
                     Margin="-230,-250,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Opacity="0.6">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowBlueCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowBlueEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowCyan" Width="560" Height="560"
                     Margin="0,-260,-200,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Opacity="0.5">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowCyanCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowCyanEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowViolet" Width="700" Height="700"
                     Margin="0,0,-200,-260" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Opacity="0.6">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowVioletCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowVioletEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse x:Name="GlowRose" Width="520" Height="520"
                     Margin="-240,0,0,-220" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                     Opacity="0.4">
                <Ellipse.RenderTransform><CompositeTransform /></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="{ThemeResource NovaGlowRoseCoreColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource NovaGlowRoseEdgeColor}" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <!--
            Layout rewrite (舒服优先):
              1) 标题栏 54px — 品牌 + 版本 + 主题切换(右) + 窗口按钮
              2) 状态条 42px — 当前页标题 + 一句提示 + 就绪胶囊
              3) 主体 — 左玻璃导航卡 212px + 右内容卡（全部页面落在 PageHost）
        -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>

                <Border Width="30" Height="30" CornerRadius="9"
                        Margin="16,0,0,0" VerticalAlignment="Center"
                        Background="{ThemeResource NovaAccentGradientBrush}">
                    <Image Width="22" Height="22" Source="Assets/NovaProtect.png"
                           Stretch="Uniform" Margin="4" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="NovaProtect" FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillSoftStyle}">
                        <TextBlock x:Name="VersionText" Style="{StaticResource PillTextStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </StackPanel>

                <controls:ThemeSwitchBar Grid.Column="3" VerticalAlignment="Center"
                                         Margin="0,0,12,0" />

                <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                           Fill="{ThemeResource NovaTitleDividerBrush}" />
            </Grid>

            <!-- Status strip -->
            <Grid Grid.Row="1" Padding="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock x:Name="PageTitleText" Text="保护项目"
                               FontFamily="Segoe UI Variable Display"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="PageHintText"
                               Text="选择目标、调整策略、构建受保护版本"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource PillSoftStyle}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusChip" Text="就绪"
                               Style="{StaticResource PillTextStyle}" />
                </Border>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="2" Padding="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Nav rail -->
                <Border CornerRadius="18"
                        Background="{ThemeResource NovaGlassCardBrush}"
                        BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
                        BorderThickness="1"
                        Padding="12,14"
                        VerticalAlignment="Stretch">
                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="工作台" FontSize="11" FontWeight="Bold"
                                   Margin="10,2,10,10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <StackPanel Spacing="2">
                            <RadioButton x:Name="NavProtect" GroupName="NovaNav" Tag="&#xE72E;"
                                         IsChecked="True" Content="保护项目"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavEvasion" GroupName="NovaNav" Tag="&#xE9D9;"
                                         Content="对抗与规避"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavInspect" GroupName="NovaNav" Tag="&#xE721;"
                                         Content="检查工具"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavActivity" GroupName="NovaNav" Tag="&#xE81C;"
                                         Content="运行记录"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavChangelog" GroupName="NovaNav" Tag="&#xE7C3;"
                                         Content="更新日志"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                        </StackPanel>

                        <Border Height="1" Margin="8,12"
                                Background="{ThemeResource NovaTitleDividerBrush}" />

                        <StackPanel Spacing="2">
                            <RadioButton x:Name="NavSettingsBtn" GroupName="NovaNav" Tag="&#xE713;"
                                         Content="设置"
                                         Style="{ThemeResource NovaNavItemButtonStyle}"
                                         Checked="Nav_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- Content card -->
                <Border Grid.Column="2" CornerRadius="18"
                        Background="{ThemeResource NovaGlassCardBrush}"
                        BorderBrush="{ThemeResource NovaGlassCardBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Stretch">
                    <Border.Shadow><ThemeShadow /></Border.Shadow>
                    <Frame x:Name="PageHost" />
                </Border>
            </Grid>
        </Grid>

        <Rectangle x:Name="BootVeil" Fill="#00FFFFFF" IsHitTestVisible="False"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
    </Grid>
</Window>
