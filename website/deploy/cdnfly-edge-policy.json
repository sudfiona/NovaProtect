{
  "format": "novaprotect-cdnfly-policy",
  "formatVersion": 2,
  "domain": "nova.fbi.plus",
  "importNote": "Declarative mapping for CDNfly console rules. It is not an official CDNfly API payload; copy the match and action values into the console. The site is static: every rule is a cache-or-bypass decision on files, and no path carries a session.",
  "priorityOrder": ["page-html", "release-feed", "site-assets", "fallback"],
  "rules": [
    {
      "id": "page-html",
      "priority": 1000,
      "match": {
        "pathExact": [
          "/",
          "/download",
          "/client-updates",
          "/sdk",
          "/privacy",
          "/404.html"
        ]
      },
      "methods": ["GET", "HEAD"],
      "actions": {
        "originPassThrough": true,
        "edgeCache": "bypass",
        "browserCache": "bypass",
        "javascriptChallenge": "off",
        "ccChallenge": "off",
        "botChallenge": "off",
        "preserveOrigin": true
      }
    },
    {
      "id": "release-feed",
      "priority": 950,
      "match": {
        "pathPrefix": ["/data/"]
      },
      "methods": ["GET", "HEAD"],
      "actions": {
        "originPassThrough": true,
        "edgeCache": "respect-origin",
        "browserCache": "respect-origin",
        "javascriptChallenge": "off",
        "ccChallenge": "off",
        "botChallenge": "off",
        "preserveOrigin": true
      }
    },
    {
      "id": "site-assets",
      "priority": 900,
      "match": {
        "pathPrefix": ["/css/", "/js/", "/assets/"],
        "pathExact": ["/favicon.ico"]
      },
      "methods": ["GET", "HEAD"],
      "actions": {
        "originPassThrough": true,
        "edgeCache": "respect-origin",
        "browserCache": "respect-origin",
        "javascriptChallenge": "off",
        "ccChallenge": "off",
        "botChallenge": "off",
        "preserveOrigin": true
      }
    },
    {
      "id": "fallback",
      "priority": 100,
      "match": { "pathPrefix": ["/"] },
      "methods": ["GET", "HEAD"],
      "actions": {
        "originPassThrough": true,
        "edgeCache": "respect-origin",
        "browserCache": "respect-origin",
        "javascriptChallenge": "keep-existing",
        "ccChallenge": "keep-existing",
        "botChallenge": "keep-existing",
        "preserveOrigin": true
      }
    }
  ],
  "originContract": {
    "forwardRequestHeaders": ["Host", "Range", "X-Forwarded-Proto"],
    "preserveResponseHeaders": ["Cache-Control", "Content-Range", "X-Content-Type-Options", "Referrer-Policy"],
    "originCache": "respect-origin-headers",
    "publicScheme": "https",
    "sessionState": "none"
  },
  "acceptance": {
    "mustNotReturnStatus": [444],
    "mustNotInjectBody": ["/_guard/auto.js"],
    "commands": ["bash deploy/cdnfly-check.sh https://nova.fbi.plus"]
  }
}
